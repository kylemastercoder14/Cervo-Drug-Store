// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Looking for ways to speed up your queries, or scale easily with your serverless or edge functions?
// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id                    String   @id @default(cuid())
  email                 String   @unique
  firstName             String
  lastName              String
  password              String
  contactNumber         String
  zipCode               String
  userType              String
  seniorPwdId           String?
  seniorPwdBookletImage String?
  seniorPwdIdImage      String?
  createdAt             DateTime @default(now())
  updatedAt             DateTime @updatedAt

  orders  Orders[]
  address Address[]
}

model Address {
  id            String   @id @default(cuid())
  firstName     String
  lastName      String
  contactNumber String
  homeAddress   String
  barangay      String
  city          String
  province      String
  region        String
  zipCode       String
  isDefault     Boolean  @default(false)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  userId String
  user   User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  orders Orders[]
}

model Admin {
  id        String   @id @default(cuid())
  name      String
  email     String
  password  String
  role      String   @default("Staff")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  logs Logs[]
}

model Banner {
  id        String   @id @default(cuid())
  image     String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Promotions {
  id         String   @id @default(cuid())
  image      String
  isFeatured Boolean  @default(false)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
}

model Categories {
  id        String   @id @default(cuid())
  name      String
  image     String
  tags      String   @unique
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  products Products[]
}

model Products {
  id                     String   @id @default(cuid())
  name                   String
  description            String?
  price                  Float
  tags                   String?
  isFeatured             Boolean  @default(false)
  isPrescriptionRequired Boolean  @default(false)
  isVatItem              Boolean  @default(false)
  image                  String?
  status                 String   @default("Available")
  createdAt              DateTime @default(now())
  updatedAt              DateTime @updatedAt

  categoryTag String?
  category    Categories? @relation(fields: [categoryTag], references: [tags], onDelete: Cascade)

  orderItems OrderItems[]
  inventory  Inventory[]
}

model Orders {
  id              String   @id @default(cuid())
  orderNumber     String
  userId          String
  email           String
  contactNumber   String?
  totalAmount     Float
  discountPrice   Float?
  orderOption     String   @default("Pick-up")
  deliveryFee     Float?
  method          String
  prescription    String?
  branch          String?
  status          String   @default("PENDING")
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  processingAt DateTime?
  shippedAt    DateTime?
  completedAt  DateTime?

  reasonCancelled String?
  cancelledAt     DateTime?

  addressId  String
  address    Address      @relation(fields: [addressId], references: [id], onDelete: Cascade)
  user       User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  OrderItems OrderItems[]
}

model OrderItems {
  id        String   @id @default(cuid())
  orderId   String
  productId String
  quantity  Int
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  order   Orders   @relation(fields: [orderId], references: [id], onDelete: Cascade)
  product Products @relation(fields: [productId], references: [id], onDelete: Cascade)
}

model Inventory {
  id        String   @id @default(cuid())
  quantity  Int
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  productId String
  product   Products @relation(fields: [productId], references: [id], onDelete: Cascade)
}

model News {
  id                 String   @id @default(cuid())
  title              String
  content            String
  image              String
  facebookPostId     String?  @unique
  facebookPermalink  String?
  facebookSyncSource String?
  facebookPublishedAt DateTime?
  lastFacebookSyncAt DateTime?
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt
}

model Logs {
  id        String   @id @default(cuid())
  action    String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  adminId String
  admin   Admin  @relation(fields: [adminId], references: [id], onDelete: Cascade)
}

model Career {
  id                String   @id @default(cuid())
  jobTitle          String
  department        String
  jobLocation       String
  experienceNeeded  String   // "With Experience" or "No Experience Required"
  yearsOfExperience Int?     // null if no experience required
  jobDescription    String   @db.Text
  jobQualification  String   @db.Text
  isActive          Boolean  @default(true)
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  applications CareerApplication[]
}

model CareerApplication {
  id            String   @id @default(cuid())
  firstName     String
  middleName    String?
  lastName      String
  position      String   // Job title from Career
  contactNumber String
  email         String
  address       String   @db.Text
  message       String?  @db.Text
  resumeUrl     String
  status        String   @default("PENDING") // PENDING, REVIEWING, APPROVED, REJECTED
  remarks       String?  @db.Text // Admin remarks for status update
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  careerId String?
  career   Career? @relation(fields: [careerId], references: [id], onDelete: SetNull)
}
